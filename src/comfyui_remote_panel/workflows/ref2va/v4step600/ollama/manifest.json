{
  "schema_version": 2,
  "id": "ref2va_v4step600_ollama",
  "name": "MiniMax H3 Ref2VA v4step600 · ollama",
  "family": "ref2va",
  "description": "Ref2VA v4step600 · ollama Prompt Backend",
  "minimum_comfyui_version": "0.26.0",
  "workflow": "workflow.json",
  "output_node": "92",
  "mode_labels": {
    "first": "1 张参考图",
    "last": "1 张参考图",
    "first+last": "2 张参考图"
  },
  "parameters": {
    "duration_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 15,
      "default": 5,
      "node": "132",
      "input": "value"
    },
    "aspect_ratio": {
      "type": "enum",
      "default": "9:16",
      "values": {
        "reference_image": "__reference_image__",
        "reference_video": "__reference_video__",
        "reference": "__reference_image__",
        "1:1": "1:1 (Square)",
        "2:3": "2:3 (Portrait Photo)",
        "3:2": "3:2 (Photo)",
        "3:4": "3:4 (Portrait Standard)",
        "4:3": "4:3 (Standard)",
        "9:16": "9:16 (Portrait Widescreen)",
        "16:9": "16:9 (Widescreen)",
        "21:9": "21:9 (Ultrawide)"
      },
      "node": "115",
      "input": "aspect_ratio"
    },
    "megapixels": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 1,
      "step": 0.1,
      "default": 0.4,
      "node": "115",
      "input": "megapixels"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "node": "129",
      "input": "noise_seed"
    },
    "prompt": {
      "type": "string",
      "node": "138",
      "input": "value"
    },
    "ollama_model": {
      "type": "string",
      "default": "gemma4:e4b",
      "node": "136",
      "input": "ollama_model",
      "ui": {
        "label": "Ollama 标准化模型",
        "semantic": "advanced"
      }
    },
    "scheduler": {
      "type": "enum",
      "default": "beta",
      "values": {
        "simple": "simple",
        "sgm_uniform": "sgm_uniform",
        "karras": "karras",
        "exponential": "exponential",
        "ddim_uniform": "ddim_uniform",
        "beta": "beta",
        "normal": "normal",
        "linear_quadratic": "linear_quadratic",
        "kl_optimal": "kl_optimal"
      },
      "node": "124",
      "input": "scheduler"
    },
    "sampler": {
      "type": "enum",
      "default": "euler",
      "values": {
        "euler": "euler",
        "euler_ancestral": "euler_ancestral",
        "heun": "heun",
        "dpmpp_2m": "dpmpp_2m",
        "dpmpp_2m_sde": "dpmpp_2m_sde",
        "dpmpp_3m_sde": "dpmpp_3m_sde",
        "res_multistep": "res_multistep",
        "res_multistep_ancestral": "res_multistep_ancestral",
        "uni_pc": "uni_pc"
      },
      "node": "149",
      "input": "sampler_name"
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 8,
      "node": "124",
      "input": "steps"
    }
  },
  "reference_aspect": {
    "parameter_value": "reference_image",
    "legacy_parameter_value": "reference",
    "video_parameter_value": "reference_video",
    "scale_class_type": "ImageScaleToTotalPixels",
    "size_class_type": "GetImageSize",
    "upscale_method": "nearest-exact",
    "resolution_steps": 32
  },
  "frame_inputs": {
    "target_node": "136",
    "first": "ref_images.ref_image_0",
    "last": "ref_images.ref_image_1"
  },
  "reference_media": {
    "target_node": "136",
    "images": {
      "max": 9,
      "loader": "LoadImage",
      "loader_input": "image",
      "input_prefix": "ref_images.ref_image_"
    },
    "videos": {
      "max": 3,
      "loader": "LoadVideo",
      "loader_input": "file",
      "components": "GetVideoComponents",
      "input_prefix": "ref_videos.ref_video_",
      "audio_input_prefix": "ref_video_audios.ref_video_audio_"
    },
    "audios": {
      "max": 3,
      "loader": "LoadAudio",
      "loader_input": "audio",
      "input_prefix": "ref_audios.ref_audio_"
    }
  },
  "locked": [
    {
      "node": "92",
      "class_type": "SaveVideo",
      "inputs": {
        "format": "auto",
        "codec": "auto"
      }
    },
    {
      "node": "115",
      "class_type": "ResolutionSelector",
      "inputs": {
        "multiple": 32
      }
    },
    {
      "node": "119",
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_video_vae_fp16.safetensors"
      }
    },
    {
      "node": "120",
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    },
    {
      "node": "124",
      "class_type": "BasicScheduler",
      "inputs": {
        "denoise": 1
      }
    },
    {
      "node": "125",
      "class_type": "SamplerCustomAdvanced"
    },
    {
      "node": "127",
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "MiniMax-H3\\minimax_h3_ref2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    {
      "node": "128",
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "MiniMax-H3\\qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
        "type": "minimax",
        "device": "default"
      }
    },
    {
      "node": "145",
      "class_type": "LoraLoader",
      "inputs": {
        "lora_name": "minimax_h3_turbo_v4_step600_ema_pruned_comfyui.safetensors",
        "strength_model": 1,
        "strength_clip": 0
      }
    },
    {
      "node": "147",
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "shift_video": 12,
        "shift_audio": 4
      }
    },
    {
      "node": "149",
      "class_type": "KSamplerSelect"
    },
    {
      "node": "130",
      "class_type": "CreateVideo",
      "inputs": {
        "fps": 24,
        "bit_depth": 8
      }
    },
    {
      "node": "131",
      "class_type": "ComfyMathExpression",
      "inputs": {
        "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17"
      }
    },
    {
      "node": "136",
      "class_type": "H3Ref2VAOllamaConditioning",
      "inputs": {
        "ref_image_size": "max"
      }
    },
    {
      "node": "153",
      "class_type": "PreviewAny"
    }
  ],
  "dependencies": [
    {
      "category": "diffusion_models",
      "name": "MiniMax-H3/minimax_h3_ref2va_pruned_int8_convrot.safetensors",
